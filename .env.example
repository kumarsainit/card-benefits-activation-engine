# ==============================================================================
# Card Benefits Activation Engine (CBAE) — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Next.js 14)
# ------------------------------------------------------------------------------
# Backend API base URL the BROWSER calls. Inlined at build time (`next build`).
# Local: http://localhost:8080/api/v1   Render: https://<backend>.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Do not set NODE_ENV for builds: NODE_ENV=production makes `npm install` skip
# devDependencies (typescript), which breaks `next build`.

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Spring Boot 3.3.4 / Java 21)
# ------------------------------------------------------------------------------
# Server Port (Auto-assigned by cloud platforms via PORT)
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Connection Details (JDBC URL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/card_benefits_db
# Alternatively, in the Docker image only: a libpq URL, converted to JDBC by
# backend/docker-entrypoint.sh when SPRING_DATASOURCE_URL is not set (used on Render).
# DATABASE_URL=postgresql://card_user:card_secure_password@localhost:5432/card_benefits_db
SPRING_DATASOURCE_USERNAME=card_user
SPRING_DATASOURCE_PASSWORD=card_secure_password

# Hibernate & Flyway
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelist (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Apache Kafka Event Bus (Optional / Fallback)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_ENABLED=false
