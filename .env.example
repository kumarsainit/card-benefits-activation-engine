# ==============================================================================
# Card Benefits Activation Engine (CBAE) — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Next.js 14)
# ------------------------------------------------------------------------------
# Target backend API base URL (Must point to deployed Spring Boot backend in production)
NEXT_PUBLIC_API_BASE_URL=https://cbae-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://cbae-backend.onrender.com/api/v1
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Spring Boot 3.3.4 / Java 21)
# ------------------------------------------------------------------------------
# Server Port (Auto-assigned by cloud platforms via PORT)
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Connection Details
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/card_benefits_db
SPRING_DATASOURCE_USERNAME=card_user
SPRING_DATASOURCE_PASSWORD=card_secure_password

# Hibernate & Flyway
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelist (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://cbae-frontend.onrender.com,https://card-benefits-activation-engine.vercel.app

# Apache Kafka Event Bus (Optional / Fallback)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_ENABLED=false
