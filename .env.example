# ===================================================
# CARD BENEFIT ACTIVATION ENGINE - ENVIRONMENT CONFIG
# ===================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/card_benefits_db
SPRING_DATASOURCE_USERNAME=card_user
SPRING_DATASOURCE_PASSWORD=card_secure_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Message Broker (Apache Kafka)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS_INCOMING=transactions.incoming
KAFKA_TOPIC_CLAIMS_EVENTS=claims.events
KAFKA_TOPIC_NOTIFICATIONS=notifications.events

# Cache (Redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
